{
    "name": "contenir/contenir-view-helper",
    "description": "Contenir View components",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contenir",
        "laminas",
        "mvc"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://docs.contenir.com.au/contenir-view-helper/",
        "issues": "https://contenir.com.au/issues",
        "source": "https://github.com/contenir/contenir-view-helper"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-cache": "^3.12",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.4",
        "laminas/laminas-config": "^3.9",
        "laminas/laminas-escaper": "^2.13",
        "laminas/laminas-form": "^3.21",
        "laminas/laminas-permissions-acl": "^2.16",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "laminas/laminas-uri": "^2.12",
        "laminas/laminas-view": "^2.35",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-i18n": "^2.33",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "laminas/laminas-i18n": "Required by the laminas-form view helpers that formGroup() renders through"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\View\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\View\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "component": "Contenir\\View",
            "config-provider": "Contenir\\View\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
